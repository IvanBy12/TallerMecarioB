# Template only -- names, never real values. Copy to .env (gitignored) and fill in locally.
# Security Baseline §1/§2: secrets live only in the environment, never in Git.

# PostgreSQL (local/CI only -- see AGENTS.md §10, never point this at staging/production)
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# Cloudflare R2 (ADR-003)
R2_ENDPOINT=
R2_REGION=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Clerk identity (ADR-006, S1-03). Leave ALL empty to boot with a deny-all
# provider; once any is set, the full set below is mandatory (fail closed).
# CLERK_AUTHORIZED_PARTIES: comma-separated frontend ORIGINS only (no `*`).
# CLERK_JWT_KEY: PEM public key (literal "\n" sequences are accepted).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=
CLERK_WEBHOOK_SIGNING_SECRET=
# Optional: defaults to https://<frontend API encoded in the publishable key>
CLERK_ISSUER_URL=
# Optional: finite Backend API timeout in ms (default 5000, max 30000)
CLERK_BACKEND_API_TIMEOUT_MS=

# Membership invitations (S1-04). Leave ALL empty to disable (no invitation
# routes, no email handler). Once ANY is set, each process requires its own
# set (fail closed):
#   API:    MEMBERSHIP_INVITATION_TOKEN_SECRET, MEMBERSHIP_INVITATION_ACCEPT_URL, MEMBERSHIP_INVITATION_EMAIL_FROM
#   worker: MEMBERSHIP_INVITATION_TOKEN_SECRET, RESEND_API_KEY (+ optional RESEND_API_BASE_URL, RESEND_TIMEOUT_MS)
# MEMBERSHIP_INVITATION_TOKEN_SECRET: base64/base64url of >= 32 random bytes; the SAME value in API and worker.
# MEMBERSHIP_INVITATION_ACCEPT_URL: PWA accept page, https (http only for localhost), no query/fragment.
#   The emailed link is <ACCEPT_URL>#token=<token> (token in the URL fragment only).
# MEMBERSHIP_INVITATION_EMAIL_FROM: verified Resend sender, e.g. "TallerMecario <invitaciones@example.com>".
# Accept URL and sender are frozen into each email job when the invitation is created: changing them
# later only affects new invitations.
# DEPLOYMENT REQUIREMENT: Resend click tracking MUST be disabled for the sending domain before any real
# E2E (a tracking redirect is not assumed to preserve the isolation of the #token fragment).
MEMBERSHIP_INVITATION_TOKEN_SECRET=
MEMBERSHIP_INVITATION_ACCEPT_URL=
MEMBERSHIP_INVITATION_EMAIL_FROM=
RESEND_API_KEY=
# Optional: defaults to https://api.resend.com
RESEND_API_BASE_URL=
# Optional: finite request timeout in ms (default 10000, max 30000). The delivery lease lasts timeout + 15 s.
RESEND_TIMEOUT_MS=

# Wompi SaaS billing. Disabled by default; all four secrets are mandatory only when enabled.
WOMPI_ENABLED=false
WOMPI_ENVIRONMENT=test
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
