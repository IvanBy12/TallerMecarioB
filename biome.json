{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noConstAssign": "error",
        "noUnreachable": "error"
      },
      "suspicious": {
        "noDebugger": "error",
        "noDoubleEquals": "error"
      }
    }
  }
}
