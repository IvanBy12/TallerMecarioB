# Template only -- names, never real values. scripts/staging-deploy-drill.cjs
# generates the real `staging.env` (gitignored) with random passwords for
# each local drill run and deletes it afterwards. This file documents the
# shape ("secrets/variables por entorno") for a real staging account later.

STAGING_POSTGRES_ADMIN_USER=
STAGING_POSTGRES_ADMIN_PASSWORD=
STAGING_POSTGRES_DB=
STAGING_POSTGRES_HOST_PORT=
STAGING_RUNTIME_DB_PASSWORD=
STAGING_API_IMAGE=
STAGING_API_HOST_PORT=

# Membership invitations (S1-04) for a REAL staging account. NOT consumed by
# the local drill: docker-compose.staging.yml forwards only DATABASE_URL, so
# invitations stay disabled there. Same contract as .env.example (fail closed:
# API needs TOKEN_SECRET + ACCEPT_URL + EMAIL_FROM, worker needs TOKEN_SECRET +
# RESEND_API_KEY; the token secret must be identical in both).
# DEPLOYMENT REQUIREMENT: Resend click tracking MUST be disabled for the
# sending domain before any real E2E.
MEMBERSHIP_INVITATION_TOKEN_SECRET=
MEMBERSHIP_INVITATION_ACCEPT_URL=
MEMBERSHIP_INVITATION_EMAIL_FROM=
RESEND_API_KEY=
RESEND_API_BASE_URL=
RESEND_TIMEOUT_MS=
